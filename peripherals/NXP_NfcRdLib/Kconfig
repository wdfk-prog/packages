menuconfig NXP_NFC_RT_DEVICE
    bool "Register RC663 as an RT-Thread device"
    depends on NXP_NFC_PORT_READY && RT_USING_DEVICE && RT_USING_MUTEX
    depends on RT_USING_PIN && RT_USING_SPI
    depends on RT_USING_EVENT && RT_USING_HEAP
    default n
    help
      Register one rc663 device. This is the sole owner of the NXP HAL/BAL
      instance and IRQ event for both MSH and the reader example.

# Local BSP package: plain source paths are relative to the BSP project root.
source "packages/NXP_NfcRdLib/msh/Kconfig"
source "packages/NXP_NfcRdLib/examples/rc663/Kconfig"

endif # PKG_USING_NXP_NFC
