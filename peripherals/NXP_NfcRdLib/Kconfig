# NXP NFC Reader Library v07.18.00 - RT-Thread package configuration.
# Enabling a component selects its upstream source files; it does not
# provide a board driver or establish functional compatibility.

menuconfig PKG_USING_NXP_NFC
    bool "NXP NFC Reader Library (licensed; RT-Thread port available for RC663 SPI)"
    depends on RT_USING_DEVICE && RT_USING_HEAP
    depends on RT_USING_EVENT && RT_USING_MUTEX && RT_USING_SEMAPHORE && RT_USING_TIMER_SOFT
    default n
    help
      Build the NXP NFC Reader Library as an RT-Thread package.
      The NXP licence must be reviewed before redistribution.
      This package includes a portable RT-Thread RC663 SPI/OSAL/DAL backend.
      The BSP must register its SPI slave and PIN devices and supply timing.

if PKG_USING_NXP_NFC

config PKG_NXP_NFC_PATH
    string
    default "/packages/peripherals/NXP_NfcRdLib"

choice
    prompt "NxpNfcRdLib version"
    default PKG_USING_NXP_NFC_V071800
    help
      Select the Reader Library version for RT-Thread package metadata.
      The bundled NxpNfcRdLib/ source is v07.18.00. For an offline/local
      BSP, selecting latest does not replace the source tree. Online
      downloading is controlled by the RT-Thread package index.

config PKG_USING_NXP_NFC_V071800
    bool "v07.18.00"

config PKG_USING_NXP_NFC_LATEST_VERSION
    bool "latest (RT-Thread rtt branch)"

endchoice

config PKG_NXP_NFC_VER
    string
    default "v07.18.00" if PKG_USING_NXP_NFC_V071800
    default "latest" if PKG_USING_NXP_NFC_LATEST_VERSION

config NXP_NFC_BUNDLED_LIB_VERSION
    string
    default "v07.18.00"
    help
      The actual NXP Reader Library revision bundled in NxpNfcRdLib/.
      This does not change when the package-index latest option is selected.

config NXP_NFC_CONFIG_FROM_KCONFIG
    bool
    default y

config NXP_NFC_PORT_READY
    bool "Enable RC663 SPI port after BSP wiring has been configured"
    depends on NXPBUILD__PHHAL_HW_RC663 && NXP_NFC_BUS_SPI
    depends on RT_USING_SPI && RT_USING_PIN
    default n
    help
      The package now provides RT-Thread OSAL, RC663 SPI BAL and PIN/IRQ DAL.
      Before enabling, configure the device and pins below and ensure the BSP
      has registered the SPI slave device and its PIN driver. This option
      does not imply hardware validation.

if NXPBUILD__PHHAL_HW_RC663 && NXP_NFC_BUS_SPI

config NXP_NFC_SPI_DEVICE_NAME
    string "RT-Thread SPI slave device name (already registered by BSP)"
    default ""
    help
      Name of an existing RT_Device_Class_SPIDevice, for example spi20.
      The package does not create or attach a device to an SPI bus.

config NXP_NFC_SPI_MAX_HZ
    int "SPI clock frequency (Hz)"
    range 100000 6000000
    default 4000000

config PHDRIVER_PIN_SSEL
    int "RT-Thread PIN index for RC663 NSS (software chip-select)"
    default -1

config PHDRIVER_PIN_RESET
    int "RT-Thread PIN index for RC663 PDOWN (active high)"
    default -1

config PHDRIVER_PIN_IRQ
    int "RT-Thread PIN index for RC663 IRQ"
    default -1

# Fixed NXP HAL board constants, emitted by Kconfig in rtconfig.h.
# The enums PH_DRIVER_PULL_{DOWN,UP} have values 0 and 1, respectively.
config PH_DRIVER_SET_HIGH
    int
    default 1

config PH_DRIVER_SET_LOW
    int
    default 0

config RESET_POWERUP_LEVEL
    int
    default 0

config RESET_POWERDOWN_LEVEL
    int
    default 1

config PHDRIVER_PIN_RESET_PULL_CFG
    int
    default 0

config PHDRIVER_PIN_IRQ_PULL_CFG
    int
    default 1

config PHDRIVER_PIN_NSS_PULL_CFG
    int
    default 1

choice
    prompt "RC663 IRQ trigger type"
    default NXP_NFC_IRQ_FALLINGEDGE

config NXP_NFC_IRQ_RISINGEDGE
    bool "Rising edge"

config NXP_NFC_IRQ_FALLINGEDGE
    bool "Falling edge"

endchoice

# Kconfig is the single source of these RT-Thread build settings.
config NXPBUILD_CUSTOMER_HEADER_INCLUDED
    bool
    default y

config PH_OSAL_RTTHREAD
    bool
    default y

config NXP_NFC_THREAD_SLICE
    int "OSAL thread time slice (RT-Thread ticks)"
    range 1 100
    default 10

endif

choice
    prompt "Reader frontend (select one)"
    default NXPBUILD__PHHAL_HW_RC663

config NXPBUILD__PHHAL_HW_RC663
    bool "RC663 / RC663 Plus"

config NXPBUILD__PHHAL_HW_PN5180
    bool "PN5180 (port not validated)"

config NXPBUILD__PHHAL_HW_PN5190
    bool "PN5190 (port not validated)"

config NXPBUILD__PHHAL_HW_PN7462AU
    bool "PN7462AU integrated controller (dedicated platform required)"

endchoice

choice
    prompt "Host communication interface"
    default NXP_NFC_BUS_SPI
    depends on !NXPBUILD__PHHAL_HW_PN7462AU

config NXP_NFC_BUS_SPI
    bool "SPI"

config NXP_NFC_BUS_I2C
    bool "I2C (RT-Thread BAL backend not implemented)"
    depends on NXPBUILD__PHHAL_HW_RC663

config NXP_NFC_BUS_UART
    bool "UART / RS232 (RT-Thread BAL backend not implemented)"
    depends on NXPBUILD__PHHAL_HW_RC663

endchoice

menu "Optional RT-Thread port runtime checks"

config NXP_NFC_CHECK_ALL
    bool "Enable optional defensive checks (master switch)"
    default y
    help
      Defaults to all checks enabled. Disabling assumes the application
      passes correct pointers, counts and configuration and never violates
      the single-reader resource contract. Mandatory error handling,
      transaction cleanup and IRQ lifetime protection remain enabled.

config NXP_NFC_CHECK_PARAM
    bool "Check API inputs (pointers, counts, ranges)"
    depends on NXP_NFC_CHECK_ALL
    default y

config NXP_NFC_CHECK_CONFIG
    bool "Check optional pin, mode and option validity"
    depends on NXP_NFC_CHECK_ALL
    default y

config NXP_NFC_CHECK_RESOURCE
    bool "Check optional single-reader resource conflicts"
    depends on NXP_NFC_CHECK_ALL
    default y

config NXP_NFC_CHECK_DEVICE
    bool "Check optional BSP device availability and type"
    depends on NXP_NFC_CHECK_ALL
    default y

endmenu

